@model Task3.Models.CodeFirst.Category

<h2>Category Details</h2>

<div class="card mt-4" style="width: 18rem;">
    <div class="card-body">
        <h5 class="card-title">Category Info</h5>
        <p class="card-text"><strong>ID:</strong> @Model.Id</p>
        <p class="card-text"><strong>Name:</strong> @Model.Name</p>
        <p class="card-text"><strong>Description:</strong> @Model.Description</p>
    </div>  
</div>