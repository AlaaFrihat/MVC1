@model IEnumerable<Task3.Models.ApplicationUser>

<h2>Manage Users (SuperAdmin)</h2>
<table class="table table-bordered mt-4">
    <thead class="table-dark">
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-warning">Change Role</a>
                    <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-danger" onclick="return confirm('Delete this user?');">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>