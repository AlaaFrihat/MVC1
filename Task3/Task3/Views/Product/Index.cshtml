@{
}
@model IEnumerable<Task3.Models.CodeFirst.Product>
<h2>Products List</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Add New Product</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Category ID</th>
            <th>Supplier ID</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Price JD</td>
                <td>@item.Quantity</td>
                <td>@item.CategoryId</td>
                <td>@item.SupplierId</td>
            </tr>
        }
    </tbody>
</table>
