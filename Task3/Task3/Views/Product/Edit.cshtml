@model Task3.Models.CodeFirst.Product

<h2>Edit Product</h2>

<form asp-action="Edit" method="post" class="mt-4">
 
    <input type="hidden" asp-for="Id" />

    <div class="form-group mb-3">
        <label>Product Name:</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label>Price:</label>
        <input asp-for="Price" type="number" step="0.01" class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label>Quantity:</label>
        <input asp-for="Quantity" type="number" class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label>Category ID:</label>
        <input asp-for="CategoryId" type="number" class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label>Supplier ID:</label>
        <input asp-for="SupplierId" type="number" class="form-control" />
    </div>

    <button type="submit" class="btn btn-warning">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>